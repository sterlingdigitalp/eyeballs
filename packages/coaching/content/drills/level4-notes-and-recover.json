{
  "id": "notes-and-recover-01",
  "version": 1,
  "name": "Glance at notes and recover",
  "mode": "presentation_rehearsal",
  "curriculumLevel": 4,
  "durationTargetSec": 80,
  "prompt": {
    "type": "outline",
    "text": "Deliver three beats. Use the outline briefly, then return before speaking.",
    "phrases": [
      "Problem",
      "Evidence",
      "Next step"
    ],
    "revealMode": "one_line",
    "hideWhenSpeaking": false
  },
  "contactPolicy": {
    "microGlanceToleranceMs": 550,
    "reportableBreakMinMs": 1050,
    "longBreakMinMs": 2300,
    "contactRecoveryConfirmMs": 250,
    "feedbackCooldownMs": 3200,
    "feedbackLevel": "standard",
    "noteAllowedNearLensMs": 1600
  },
  "scoring": {
    "excludeFirstSec": 2,
    "excludeLastSec": 1,
    "sentenceBoundaryContact": true,
    "speakingWindowsOnly": true
  },
  "noteAllowedIntervals": [
    { "startSec": 12, "endSec": 17, "label": "Check problem" },
    { "startSec": 34, "endSec": 39, "label": "Check evidence" },
    { "startSec": 56, "endSec": 61, "label": "Check next step" }
  ],
  "completion": {
    "minimumSpeakingSec": 40,
    "minimumDurationSec": 60
  },
  "reflection": [
    "Did you finish reading before you resumed speaking?",
    "Which return to the lens felt quickest and most natural?"
  ],
  "liveAssist": false,
  "recordingDefault": "optional"
}
